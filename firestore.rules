rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role(r) { return signedIn() && me().role == r; }
    function admin() { return signedIn() && me().role == 'admin'; }
    function supervisor() { return signedIn() && me().role == 'supervisor'; }
    function manager() { return admin() || supervisor(); }
    function sameOrg(org) { return signedIn() && me().orgId == org; }
    function assignedRoute(rid) { return signedIn() && rid in me().routeIds; }

    match /users/{uid} {
      allow read: if signedIn() && ((request.auth.uid == uid && sameOrg(resource.data.orgId)) || (admin() && sameOrg(resource.data.orgId)));
      allow write: if admin() && sameOrg(request.resource.data.orgId);
    }

    match /orgs/{orgId}/routes/{id} {
      allow read: if sameOrg(orgId) && (manager() || resource.data.collectorId == request.auth.uid);
      allow create, update, delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/clients/{id} {
      allow read: if sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create: if sameOrg(orgId) && (manager() || assignedRoute(request.resource.data.routeId));
      allow update: if sameOrg(orgId) && (manager() || (assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if manager() && sameOrg(orgId);
    }

    match /orgs/{orgId}/credits/{id} {
      allow read: if sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create, update, delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/payments/{id} {
      allow read: if sameOrg(orgId) && (manager() || request.auth.uid == resource.data.userId);
      allow create: if sameOrg(orgId) && (manager() || (request.resource.data.userId == request.auth.uid && assignedRoute(request.resource.data.routeId)));
      allow update, delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/cashClosures/{id} {
      allow read: if sameOrg(orgId) && (manager() || resource.data.userId == request.auth.uid);
      allow create: if sameOrg(orgId) && (manager() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/approvals/{id} {
      allow read: if sameOrg(orgId) && (manager() || resource.data.requestedByUid == request.auth.uid);
      allow create: if sameOrg(orgId) && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if sameOrg(orgId) && manager();
      allow delete: if sameOrg(orgId) && admin();
    }

    match /orgs/{orgId}/{collection}/{id} {
      allow read, write: if sameOrg(orgId) && manager() && collection in ['capital','entries','expenses','audit'];
    }
  }
}
