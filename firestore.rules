rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function validRole(r) { return r in ['admin','supervisor','cobrador','consulta']; }
    function admin() { return signedIn() && me().role == 'admin'; }
    function supervisor() { return signedIn() && me().role == 'supervisor'; }
    function manager() { return admin() || supervisor(); }
    function sameOrg(org) { return signedIn() && me().orgId == org; }
    function assignedRoute(rid) { return signedIn() && me().routeIds is list && rid in me().routeIds; }
    function validUserProfile(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.orgId is string
        && request.resource.data.orgId == me().orgId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && validRole(request.resource.data.role)
        && request.resource.data.routeIds is list
        && request.resource.data.active is bool;
    }

    match /users/{uid} {
      allow read: if signedIn() && ((request.auth.uid == uid && sameOrg(resource.data.orgId)) || (manager() && sameOrg(resource.data.orgId)));
      allow create: if admin() && validUserProfile(uid);
      allow update: if admin() && validUserProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if admin() && sameOrg(resource.data.orgId);
    }

    match /orgs/{orgId}/routes/{id} {
      allow read: if sameOrg(orgId) && (manager() || resource.data.collectorId == request.auth.uid);
      allow create, update, delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/clients/{id} {
      allow read: if sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create: if sameOrg(orgId) && (manager() || assignedRoute(request.resource.data.routeId));
      allow update: if sameOrg(orgId) && (manager() || (assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if manager() && sameOrg(orgId);
    }

    match /orgs/{orgId}/credits/{id} {
      allow read: if sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create: if sameOrg(orgId) && (manager() || assignedRoute(request.resource.data.routeId));
      allow update: if sameOrg(orgId) && (manager() || (assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/payments/{id} {
      allow read: if sameOrg(orgId) && (manager() || request.auth.uid == resource.data.userId);
      allow create: if sameOrg(orgId) && (manager() || (request.resource.data.userId == request.auth.uid && assignedRoute(request.resource.data.routeId)));
      allow update: if sameOrg(orgId) && (manager() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/cashClosures/{id} {
      allow read: if sameOrg(orgId) && (manager() || resource.data.userId == request.auth.uid);
      allow create: if sameOrg(orgId) && (manager() || request.resource.data.userId == request.auth.uid);
      allow update: if sameOrg(orgId) && (manager() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid));
      allow delete: if sameOrg(orgId) && manager();
    }

    match /orgs/{orgId}/approvals/{id} {
      allow read: if sameOrg(orgId) && (manager() || resource.data.requestedByUid == request.auth.uid);
      allow create: if sameOrg(orgId) && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if sameOrg(orgId) && (manager() || (resource.data.requestedByUid == request.auth.uid && request.resource.data.requestedByUid == resource.data.requestedByUid && request.resource.data.status == resource.data.status));
      allow delete: if sameOrg(orgId) && admin();
    }

    match /orgs/{orgId}/{collection}/{id} {
      allow read, write: if sameOrg(orgId) && manager() && collection in ['capital','entries','expenses','audit'];
    }
  }
}
