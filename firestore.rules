rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function validRole(r) { return r in ['admin','supervisor','cobrador','consulta']; }
    function admin() { return signedIn() && me().role == 'admin'; }
    function supervisor() { return signedIn() && me().role == 'supervisor'; }
    function manager() { return admin() || supervisor(); }
    function sameOrg(org) { return signedIn() && me().orgId == org; }
    function assignedRoute(rid) { return signedIn() && me().routeIds is list && rid in me().routeIds; }
    function validUserProfile(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.orgId is string
        && request.resource.data.orgId == me().orgId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && validRole(request.resource.data.role)
        && request.resource.data.routeIds is list
        && request.resource.data.active is bool;
    }
    // V2 pilot authorization is deliberately separate from the legacy /users profile.
    // A V1 user profile cannot grant V2 access by itself.
    function v2Org(orgId) { return orgId == 'v2-mi-cartera-pilot'; }
    function v2Member(orgId) {
      return signedIn() && v2Org(orgId)
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    function v2Me(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
    }
    function v2Active(orgId) { return v2Member(orgId) && v2Me(orgId).active == true; }
    function v2Manager(orgId) { return v2Active(orgId) && v2Me(orgId).role in ['admin','supervisor']; }
    function v2Collector(orgId) { return v2Active(orgId) && v2Me(orgId).role == 'cobrador'; }
    function v2AssignedRoute(orgId, rid) { return v2Active(orgId) && v2Me(orgId).routeIds is list && rid in v2Me(orgId).routeIds; }
    // A commercial worker is a separately provisioned membership, never a self-assigned role.
    function v2WorkerMember(orgId) { return v2Active(orgId) && v2Me(orgId).role == 'gestor' && v2Me(orgId).workerId is string; }
    function v2WorkerLive(orgId) {
      let member = v2Me(orgId);
      let worker = get(/databases/$(database)/documents/orgs/$(orgId)/routes/$(member.workerId)).data;
      return signedIn() && v2Org(orgId) && member.active == true && member.role == 'gestor'
        && member.workerId is string && worker.recordType == 'WORKER' && worker.active == true
        && worker.authUid == request.auth.uid && member.routeIds is list && worker.routeId in member.routeIds
        && get(/databases/$(database)/documents/orgs/$(orgId)/routes/$(worker.routeId)).data.active == true;
    }
    function v2Owned(orgId, data) { let member = v2Me(orgId); return v2WorkerLive(orgId) && data.workerId == member.workerId && member.routeIds is list && data.routeId in member.routeIds; }
    function v2WorkerRead(orgId, data) { return v2WorkerLive(orgId) && data.workerId == v2Me(orgId).workerId; }
    function v2ContactAccess(orgId, clientId) {
      let key = "client-access-" + v2Me(orgId).workerId + "-" + clientId;
      let path = /databases/$(database)/documents/orgs/$(orgId)/routes/$(key);
      return v2WorkerLive(orgId) && exists(path) && get(path).data.recordType == 'CLIENT_ACCESS'
        && get(path).data.active == true && get(path).data.workerId == v2Me(orgId).workerId
        && get(path).data.clientId == clientId;
    }
    function v2ContactForCredit(orgId, clientId) {
      let key = "client-access-" + v2Me(orgId).workerId + "-" + clientId;
      return v2ContactAccess(orgId, clientId)
        && get(/databases/$(database)/documents/orgs/$(orgId)/routes/$(key)).data.creditCount > 0;
    }
    function v2WorkerCash(orgId, data, collection) {
      return v2Owned(orgId, data) && data.cashAccountId == v2Me(orgId).workerId && data.amount > 0 && (
        (collection == 'entries' && data.type == 'INGRESO' && data.concept in ['COBRO_CUOTA','COBRO_INTERES']
          && !exists(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref))
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.workerId == data.workerId
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.cashMovementId == data.id
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.amount == data.amount)
        || (collection == 'expenses' && data.type == 'EGRESO' && data.concept in ['DESEMBOLSO_CREDITO','DESEMBOLSO_REFINANCIAMIENTO']
          && !exists(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref))
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.workerId == data.workerId
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.disbursementMovementId == data.id
          && ((data.concept == 'DESEMBOLSO_CREDITO' && data.amount == getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.capital)
            || (data.concept == 'DESEMBOLSO_REFINANCIAMIENTO' && data.amount == getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.netDisbursement)))
      );
    }

    // V2 isolated pilot readiness marker. Read-only and contains no financial records.
    match /orgs/v2-mi-cartera-pilot {
      allow read: if true;
      allow write: if false;
    }

    // V2 membership documents are provisioned administratively, never self-created by the browser.
    match /orgs/{orgId}/members/{uid} {
      allow read: if v2Org(orgId) && signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Explicit V2 pilot paths. No deletes; payments/audit are append-only.
    match /orgs/{orgId}/clients/{id} {
      allow read: if v2Org(orgId) && (v2Manager(orgId) || (v2Collector(orgId) && v2AssignedRoute(orgId, resource.data.routeId)));
      allow create: if v2Org(orgId) && (v2Manager(orgId) || (v2Collector(orgId) && v2AssignedRoute(orgId, request.resource.data.routeId)));
      allow update: if v2Org(orgId) && v2Manager(orgId);
      allow delete: if false;
      allow get: if v2WorkerLive(orgId) && (!exists(/databases/$(database)/documents/orgs/$(orgId)/clients/$(id)) || v2Owned(orgId, resource.data) || v2ContactAccess(orgId, id));
      allow list: if v2WorkerRead(orgId, resource.data);
      allow create: if v2Owned(orgId, request.resource.data);
      allow update: if v2Owned(orgId, resource.data) && v2Owned(orgId, request.resource.data)
        && request.resource.data.routeId == resource.data.routeId && request.resource.data.workerId == resource.data.workerId;
    }
    match /orgs/{orgId}/credits/{id} {
      allow read: if v2Org(orgId) && (v2Manager(orgId) || (v2Collector(orgId) && v2AssignedRoute(orgId, resource.data.routeId)));
      allow create, update: if v2Org(orgId) && v2Manager(orgId);
      allow delete: if false;
      allow get: if v2WorkerLive(orgId) && (!exists(/databases/$(database)/documents/orgs/$(orgId)/credits/$(id)) || v2Owned(orgId, resource.data));
      allow list: if v2WorkerRead(orgId, resource.data);
      allow create: if v2Owned(orgId, request.resource.data)
        && (getAfter(/databases/$(database)/documents/orgs/$(orgId)/clients/$(request.resource.data.clientId)).data.workerId == v2Me(orgId).workerId || v2ContactForCredit(orgId, request.resource.data.clientId));
      allow update: if v2Owned(orgId, resource.data) && v2Owned(orgId, request.resource.data)
        && request.resource.data.clientId == resource.data.clientId && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.routeId == resource.data.routeId;
    }
    match /orgs/{orgId}/payments/{id} {
      allow read: if v2Org(orgId) && (v2Manager(orgId) || (v2Collector(orgId) && resource.data.userId == request.auth.uid));
      allow create: if v2Org(orgId) && (v2Manager(orgId) || (v2Collector(orgId) && request.resource.data.userId == request.auth.uid && v2AssignedRoute(orgId, request.resource.data.routeId)));
      allow update, delete: if false;
      allow get: if v2WorkerLive(orgId) && (!exists(/databases/$(database)/documents/orgs/$(orgId)/payments/$(id)) || v2Owned(orgId, resource.data));
      allow list: if v2WorkerRead(orgId, resource.data);
      allow create: if v2Owned(orgId, request.resource.data) && request.resource.data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(request.resource.data.creditId)).data.workerId == v2Me(orgId).workerId;
    }
    match /orgs/{orgId}/audit/{id} {
      allow read: if v2Org(orgId) && v2Manager(orgId);
      allow create: if v2Org(orgId) && v2Active(orgId);
      allow update, delete: if false;
      allow get: if v2WorkerLive(orgId) && (!exists(/databases/$(database)/documents/orgs/$(orgId)/audit/$(id)) || resource.data.actorId == request.auth.uid);
      allow list: if v2WorkerLive(orgId) && resource.data.actorId == request.auth.uid;
    }
    // Idempotency records for the V2 transactional sync boundary. They are
    // isolated from V1 and cannot be deleted by the browser.
    match /orgs/{orgId}/operations/{id} {
      allow read: if v2Org(orgId) && v2Manager(orgId);
      allow create, update: if v2Org(orgId) && v2Manager(orgId);
      allow delete: if false;
      allow get: if v2WorkerLive(orgId) && (!exists(/databases/$(database)/documents/orgs/$(orgId)/operations/$(id)) || resource.data.actorId == request.auth.uid);
      allow create: if v2WorkerLive(orgId) && request.resource.data.actorId == request.auth.uid;
    }
    match /orgs/{orgId}/{collection}/{id} {
      allow read, create, update: if v2Org(orgId) && v2Manager(orgId) && collection in ['capital','entries','expenses','cashClosures','routes'];
      allow delete: if false;
      allow get: if collection in ['entries','expenses'] && v2WorkerLive(orgId)
        && (!exists(/databases/$(database)/documents/orgs/$(orgId)/$(collection)/$(id)) || v2Owned(orgId, resource.data));
      allow list: if collection in ['entries','expenses'] && v2WorkerRead(orgId, resource.data);
      allow create: if collection in ['entries','expenses'] && v2WorkerCash(orgId, request.resource.data, collection);
      allow update: if collection == 'entries' && v2Owned(orgId, resource.data) && request.resource.data.tombstone == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tombstone','deletedAt','version','updatedAt'])
        && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$("reversal-" + resource.data.ref)).data.reversesPaymentId == resource.data.ref;
      allow get: if collection == 'routes' && v2WorkerMember(orgId)
        && (id == v2Me(orgId).workerId || v2AssignedRoute(orgId, id) || resource.data.workerId == v2Me(orgId).workerId);
      allow list: if collection == 'routes' && v2WorkerLive(orgId) && resource.data.workerId == v2Me(orgId).workerId;
    }

    // Legacy V1 rules remain unchanged in behavior, but explicitly exclude the V2 pilot org
    // so overlapping Firestore matches cannot broaden V2 permissions.
    match /users/{uid} {
      allow read: if signedIn() && ((request.auth.uid == uid && sameOrg(resource.data.orgId)) || (manager() && sameOrg(resource.data.orgId)));
      allow create: if admin() && validUserProfile(uid);
      allow update: if admin() && validUserProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if admin() && sameOrg(resource.data.orgId);
    }
    match /orgs/{orgId}/routes/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || resource.data.collectorId == request.auth.uid);
      allow create, update, delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/clients/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(request.resource.data.routeId));
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if !v2Org(orgId) && manager() && sameOrg(orgId);
    }
    match /orgs/{orgId}/credits/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(request.resource.data.routeId));
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/payments/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || request.auth.uid == resource.data.userId);
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (request.resource.data.userId == request.auth.uid && assignedRoute(request.resource.data.routeId)));
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/cashClosures/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || resource.data.userId == request.auth.uid);
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || request.resource.data.userId == request.auth.uid);
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/approvals/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || resource.data.requestedByUid == request.auth.uid);
      allow create: if !v2Org(orgId) && sameOrg(orgId) && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (resource.data.requestedByUid == request.auth.uid && request.resource.data.requestedByUid == resource.data.requestedByUid && request.resource.data.status == resource.data.status));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && admin();
    }
    match /orgs/{orgId}/{collection}/{id} {
      allow read, write: if !v2Org(orgId) && sameOrg(orgId) && manager() && collection in ['capital','entries','expenses','audit'];
    }
  }
}
