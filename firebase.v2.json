{
  "hosting": {
    "target": "v2",
    "public": "v2",
    "ignore": ["firebase.v2.json","**/.*","**/node_modules/**"],
    "headers": [
      {"source":"/app/index.html","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/app/release.json","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/app/service-worker.js","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
      {"source":"/app/manifest.webmanifest","headers":[{"key":"Content-Type","value":"application/manifest+json"}]}
    ],
    "redirects": [{"source":"/","destination":"/app/index.html","type":302}],
    "rewrites": []
  }
}