{
  "hosting": {
    "target": "v2",
    "public": "v2",
    "ignore": [
      "firebase.v2.json",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "migration/**",
      "docs/**"
    ],
    "headers": [
      {
        "source": "/app/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/firebase-v2-template.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/pilot-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/preflight-ui.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/release.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/app/index.html",
        "type": 302
      },
      {
        "source": "/operational-shell.html",
        "destination": "/app/operational-shell.html",
        "type": 302
      },
      {
        "source": "/index.html",
        "destination": "/app/index.html",
        "type": 302
      }
    ],
    "rewrites": []
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
