{
  "name": "Mi Cartera PRO V2",
  "short_name": "Cartera V2",
  "id": "/app/",
  "start_url": "/app/operational-shell.html",
  "scope": "/app/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#f5f7f6",
  "theme_color": "#17201b",
  "description": "Mi Cartera PRO V2 — aplicación independiente de validación",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
