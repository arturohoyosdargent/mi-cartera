        && ncKey(d.id) && d.type==type && d.concept==concept && d.ref==ref && npMoney(d.amount) && d.amount>0 && d.amount==amount
        && d.date==npToday() && d.routeId==p.credit.routeId && d.version==1 && d.actorId==p.actorId
