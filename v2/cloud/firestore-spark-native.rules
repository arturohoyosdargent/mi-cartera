        && c.id==p.creditId && ncKey(c.id) && ncKey(c.clientId) && c.version==1 && c.status=='ACTIVO'
        && c.principalPaid==0 && c.interestPaid==0 && c.penaltyPaid==0 && c.nativeCreditOperationId==p.id
