        && pay.id==p.paymentId && ncKey(pay.id) && pay.creditId==c.id && pay.clientId==c.clientId && pay.routeId==p.credit.routeId
        && pay.userId==p.actorId && pay.workerId==c.get('workerId','') && pay.workerAttribution=={'source':'CREDIT_ASSIGNMENT_AT_RENEWAL'}
        && pay.date==npToday() && pay.concept=='INTERES' && pay.capitalAmount==0 && pay.interestAmount==amount && pay.penaltyAmount==0 && pay.amount==amount && pay.operationId==p.id && pay.version==1
