        && n.interestPaid==(p.type=='INTEREST_RENEWAL'?math.round((c.get('interestPaid',0)+ncInterest(c))*100) / 100.0:c.get('interestPaid',0))
        && p.credit.clientId==c.clientId && p.credit.routeId==c.get('routeId','') && p.credit.get('workerId','')==c.get('workerId','')
        && p.credit.renewedFrom==c.id && p.credit.operationId==p.id && p.credit.date==npToday()
