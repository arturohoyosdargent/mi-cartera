    }
    function ncBundle(o,op,id) {
      let p=npGet(o,'creditProposals',id);
      return op.keys().hasOnly(['id','type','protocol','actorId','status','proposalId','newCertificateId','oldCertificateId','writeCount','appliedAt'])
        && op.id==id && op.proposalId==id && op.type==p.type && op.protocol=='spark-credit-v1' && op.actorId==request.auth.uid && op.actorId==p.actorId
        && op.status=='APPLIED' && op.appliedAt==request.time && op.writeCount==ncCount(p) && ncManager(o)
        && p.audit.role==npGet(o,'members',request.auth.uid).role
        && ncNewCertificate(o,p,op.newCertificateId) && (p.oldCredit==null?op.oldCertificateId=='':npStamped(npAfter(o,'credits',p.oldCreditId),p.oldCredit))
        && npStamped(npAfter(o,'credits',p.creditId),p.credit) && npStamped(npAfter(o,'audit',p.auditId),p.audit) && ncOptionalCompanions(o,p);
    }
    function ncAuditDetails(p) {
      return p.type=='CREDIT_CREATE'?p.audit.detail.accepted==true&&p.audit.detail.clientId==p.credit.clientId&&p.audit.detail.capital==p.credit.capital
        :p.audit.detail.from==p.oldCreditId&&(p.type=='INTEREST_RENEWAL'?p.audit.detail.interest==p.payment.amount
          :p.audit.detail.previousBalance==p.credit.previousBalance&&p.audit.detail.newCapital==p.credit.capital&&p.audit.detail.cashDisbursed==p.credit.netDisbursement);
    }
    function ncField(o,p,op,field) {
      return field=='credit'?!exists(/databases/$(database)/documents/orgs/$(o)/credits/$(p.creditId))&&ncPrepared(o,p)&&ncIndexAfter(o,p)
        :field=='oldCredit'?p.type!='CREDIT_CREATE'&&ncPrepared(o,p)&&ncRenewMoney(o,p,op.oldCertificateId)
        :field!='audit'||npCashAfter(o,op.id,'leader',p.entry!=null?npCents(p.entry.amount):p.expense!=null?-npCents(p.expense.amount):0);
    }
    function ncCompanion(o,operationId,field,id) {
      let p=npGet(o,'creditProposals',operationId);
      let op=npAfter(o,'operations',operationId);
      return ncManager(o) && p.actorId==request.auth.uid && p.audit.role==npGet(o,'members',request.auth.uid).role
        && op.id==operationId && op.proposalId==operationId && op.actorId==p.actorId && op.type==p.type && op.protocol=='spark-credit-v1'
        && op.status=='APPLIED' && op.appliedAt==request.time && op.writeCount==ncCount(p)
        && p[field]!=null && p[field].id==id && npStamped(request.resource.data,p[field]) && ncField(o,p,op,field);
    }
    function ncCreditCompanion(o,id) {
      let operationId=request.resource.data.nativeCreditOperationId;
      let p=npGet(o,'creditProposals',operationId);
      return id==p.creditId?ncCompanion(o,operationId,'credit',id):id==p.oldCreditId&&ncCompanion(o,operationId,'oldCredit',id);
    }
    match /orgs/{o}/creditProposals/{id} {
      allow get: if ncManager(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/creditProposals/$(id))||resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && ncProposal(o,request.resource.data,id);
      allow update,delete: if false;
    }
    match /orgs/{o}/creditCertificates/{id} {
      allow get: if ncManager(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/creditCertificates/$(id))||resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && ncCertificate(o,request.resource.data,id);
      allow update,delete: if false;
    }
    match /orgs/{o}/creditAuthorizations/{id} {
      allow get: if ncManager(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/creditAuthorizations/$(id))||resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && ncAuthorization(o,request.resource.data,id);
      allow update,delete: if false;
    }
    match /orgs/{o}/financialControls/{id} {
      allow create: if signedIn() && v2Org(o) && id.matches('^credit--.*$') && ncIndexCreate(o,request.resource.data,id);
    }
    // Integration hooks, not standalone broad grants:
    // credits create/update: ncCreditCompanion(o,id)
    // payments/entries/expenses/audit create: ncCompanion(o,request.resource.data.operationId,'payment'/'entry'/'expense'/'audit',id)
    // operations create: ncBundle(o,request.resource.data,id)
    // Spark partner loan journals. Preparation is immutable and moves no money.
    // Large legacy journals are proved one row at a time within Rules limits.
    function nsManager(o) { return ncManager(o); }
    function nsTypes(t) { return t in ['PARTNER_LOAN_CREATED','PARTNER_INTEREST_PAID','PARTNER_CAPITAL_RETURNED','PARTNER_SETTLED','PARTNER_CONTACT_UPDATED']; }
    function nsPrepared(o,p) {
      return nsManager(o) && p.actorId==request.auth.uid && p.audit.role==npGet(o,'members',request.auth.uid).role
        && (p.expectedVersion==0?!exists(/databases/$(database)/documents/orgs/$(o)/entries/$(p.loanId))
          :npGet(o,'entries',p.loanId).version==p.expectedVersion && npGet(o,'entries',p.loanId).get('tombstone',false)==false
           && npGet(o,'entries',p.loanId).get('noReplay',false)==false && npGet(o,'entries',p.loanId).get('administrativeClosure',{}).get('noReplay',false)==false);
    }
    function nsProposal(o,p,id) {
      return p.keys().hasOnly(['id','protocol','type','actorId','loanId','expectedVersion','financial','date','dateParts','loanDateParts','firstDueParts','dueParts','nextTermParts','deltaCents','registryKey','master','expense','audit','journal','nextTerm'])
        && p.id==id && npKey(id) && p.protocol=='spark-partners-v1' && nsTypes(p.type) && p.actorId==request.auth.uid && nsManager(o)
        && npKey(p.loanId) && p.master.id==p.loanId && p.master.partnerLoan.id==p.loanId && p.master.nativePartnerOperationId==id
        && p.expectedVersion is int && p.expectedVersion>=0 && p.master.version==p.expectedVersion+1
        && (p.expectedVersion==0)==(p.type=='PARTNER_LOAN_CREATED') && p.financial==(p.type!='PARTNER_CONTACT_UPDATED')
        && ncDay(p.date) && p.date<=npToday() && p.deltaCents is int && p.audit.actorId==p.actorId && p.audit.operationId==id
        && p.audit.role==npGet(o,'members',request.auth.uid).role && nsPrepared(o,p);
    }
    function nsPhone(v) { return v is string && v.matches('^([1-9][0-9]{9,14})?$'); }
    function nsLoan(l) {
      return l.id is string && l.partner is string && l.partner==l.partner.trim() && l.partner.size()>0 && l.partner.size()<=200
        && ncDay(l.date) && ncDay(l.firstDue) && npMoney(l.principal) && l.principal>0 && npMoney(l.rate) && l.rate>0
        && l.historical is bool && l.interestPayments is list && l.repayments is list && l.terms is list && l.terms.size()>0;
    }
    function nsCreated(p) {
      let m=p.master;
      let l=m.partnerLoan;
      let start=ncDateStamp(l.date);
      let first=ncDateStamp(l.firstDue);
      let months=(first.year()-start.year())*12+first.month()-start.month();
      return m.keys().hasOnly(['id','date','type','amount','category','concept','ref','version','partnerLoan','partnerPhone','updatedAt','nativePartnerOperationId'])
        && l.keys().hasOnly(['id','partner','date','principal','rate','firstDue','historical','interestPayments','repayments','terms','closedAt'])
        && nsLoan(l) && m.date==l.date && m.type=='INGRESO' && m.category=='PRESTAMO_SOCIO' && m.concept=='Préstamo de '+l.partner && m.ref==m.id
        && m.amount==(l.historical?0:l.principal) && l.date==p.date && l.interestPayments.size()==0 && l.repayments.size()==0 && l.terms.size()==1 && l.closedAt==null
        && months>=1 && months<=2400 && ncMonthly(start,months)==first && nsPhone(m.get('partnerPhone',''))
        && l.terms[0].keys().hasOnly(['from','amount']) && l.terms[0].from==l.firstDue
        && l.terms[0].amount==math.round(l.principal*l.rate) / 100.0 && l.terms[0].amount>0;
    }
    function nsContext(o,p) {
      let old=npGet(o,'entries',p.loanId);
      let m=p.master;
      let l=m.partnerLoan;
      let b=old.partnerLoan;
      let interest=p.type=='PARTNER_INTEREST_PAID';
      return old.type=='INGRESO' && old.category=='PRESTAMO_SOCIO' && nsLoan(b)
        && m.diff(old).affectedKeys().hasOnly(['partnerLoan','partnerPhone','version','updatedAt','acceptedAt','nativePartnerOperationId'])
        && (p.type=='PARTNER_CONTACT_UPDATED'?m.partnerLoan==b && nsPhone(m.partnerPhone)
          :m.get('partnerPhone','')==old.get('partnerPhone','') && l.diff(b).affectedKeys().hasOnly(['interestPayments','repayments','terms','closedAt'])
           && l.interestPayments.size()==b.interestPayments.size()+(interest?1:0) && l.repayments.size()==b.repayments.size()+(interest?0:1)
           && l.terms.size()==b.terms.size()+(p.nextTerm==null?0:1)
           && (interest?l.repayments==b.repayments && l.terms==b.terms && l.closedAt==b.closedAt && l.interestPayments[b.interestPayments.size()]==p.journal
             :l.interestPayments==b.interestPayments && l.repayments[b.repayments.size()]==p.journal
              && (p.nextTerm==null?l.terms==b.terms && l.closedAt==p.date:l.terms[b.terms.size()]==p.nextTerm && l.closedAt==b.closedAt)));
    }
    function nsDue(l,due) {
      let start=ncDateStamp(l.date);
      let t=ncDateStamp(due);
      let months=(t.year()-start.year())*12+t.month()-start.month();
      return months>=1 && months<=2400 && due>=l.firstDue && ncMonthly(start,months)==t && (l.closedAt==null||due<=l.closedAt);
    }
    function nsNextTerm(l,p) {
      let start=ncDateStamp(l.date);
      let paid=ncDateStamp(p.date);
      let months=npMax(1,(paid.year()-start.year())*12+paid.month()-start.month());
      let candidate=ncMonthly(start,months);
      return p.nextTerm.keys().hasOnly(['from','amount']) && npMoney(p.nextTerm.amount) && p.nextTerm.amount>0
        && ncDateStamp(p.nextTerm.from)==(candidate>paid?candidate:ncMonthly(start,months+1));
    }
    function nsExpense(o,p) {
      let e=p.expense;
      let j=p.journal;
      let l=npGet(o,'entries',p.loanId).partnerLoan;
      return e.keys().hasOnly(['id','date','type','amount','category','concept','ref','partnerLoanId','version','operationId','interestDue','userId','cashAccountId'])
        && npKey(e.id) && e.type=='EGRESO' && e.date==p.date && e.date>=l.date && e.date==npToday()
        && npMoney(e.amount) && e.amount>0 && e.ref==p.loanId && e.partnerLoanId==p.loanId && e.version==1 && e.operationId==p.id && e.userId==p.actorId && e.cashAccountId=='leader'
        && j.id==e.id && j.date==e.date && j.amount==e.amount && p.deltaCents==-npCents(e.amount)
        && (p.type=='PARTNER_INTEREST_PAID'?e.category=='INTERES_SOCIO' && j.keys().hasOnly(['id','date','due','amount']) && e.interestDue==j.due && j.due<=p.date && nsDue(l,j.due) && p.nextTerm==null
          :e.category=='DEVOLUCION_CAPITAL_SOCIO' && j.keys().hasOnly(['id','date','amount']) && !e.keys().hasAny(['interestDue']) && (p.nextTerm==null||nsNextTerm(l,p)));
    }
    function nsLedger(o,p) {
      return p.type=='PARTNER_LOAN_CREATED'?p.expense==null && p.journal==null && p.nextTerm==null && p.deltaCents==npCents(p.master.amount) && p.date==npToday()
        :p.type=='PARTNER_CONTACT_UPDATED'?p.expense==null && p.journal==null && p.nextTerm==null && p.deltaCents==0
        :nsExpense(o,p);
    }
    function nsAudit(p) {
      let a=p.audit;
      return npKey(a.id) && a.actorId==p.actorId && a.action==p.type && a.entityType=='PARTNER_LOAN' && a.entityId==p.loanId && a.operationId==p.id && a.version==1
        && a.detail.ids is list && a.detail.ids==(p.expense==null?[p.loanId]:[p.loanId,p.expense.id]);
    }
    function nsAuthorization(o,a,id) {
      let p=npGet(o,'partnerProposals',a.operationId);
      return a.keys().hasOnly(['id','protocol','operationId','actorId','loanId','expectedVersion','kind']) && a.protocol=='spark-partners-v1'
        && a.id==id && id==p.id+'--'+a.kind && a.actorId==request.auth.uid && a.actorId==p.actorId && a.loanId==p.loanId && a.expectedVersion==p.expectedVersion
        && nsPrepared(o,p) && (a.kind=='context'?(p.expectedVersion==0?nsCreated(p):nsContext(o,p)):a.kind=='ledger'?nsLedger(o,p):a.kind=='audit'&&nsAudit(p));
    }
    function nsAuthorized(o,p,kind) { let a=npGet(o,'partnerAuthorizations',p.id+'--'+kind); return a.operationId==p.id && a.actorId==p.actorId && a.kind==kind; }
    function nsInitial() { return {'repaidCents':0,'lastRepayDate':'','maxPaidDue':'','duplicateId':false,'duplicateDue':false,'termCents':0,'termFound':false,'eligibleRepayments':0}; }
    function nsOldRow(old,next) { return next.diff(old).affectedKeys().hasOnly(['amount']) && next.amount==old.amount; }
    function nsRepayment(p,old,next,s,t) {
      return nsOldRow(old,next) && npKey(old.id) && ncDay(old.date) && npMoney(old.amount) && old.amount>0
        && t=={'repaidCents':s.repaidCents+npCents(old.amount),'lastRepayDate':npMax(s.lastRepayDate,old.date),'maxPaidDue':s.maxPaidDue,
          'duplicateId':s.duplicateId||old.id==p.expense.id,'duplicateDue':s.duplicateDue,'termCents':s.termCents,'termFound':s.termFound,'eligibleRepayments':s.eligibleRepayments+(old.date<=p.date?1:0)};
    }
    function nsInterest(p,old,next,s,t) {
      return nsOldRow(old,next) && npKey(old.id) && ncDay(old.date) && ncDay(old.due) && npMoney(old.amount) && old.amount>=0
        && t=={'repaidCents':s.repaidCents,'lastRepayDate':s.lastRepayDate,'maxPaidDue':npMax(s.maxPaidDue,old.due),
          'duplicateId':s.duplicateId||old.id==p.expense.id,'duplicateDue':s.duplicateDue||old.due==p.journal.get('due',''),'termCents':s.termCents,'termFound':s.termFound,'eligibleRepayments':s.eligibleRepayments};
    }
    function nsTerm(p,old,next,s,t,rowIndex) {
      let eligible=rowIndex<1+s.eligibleRepayments && old.from<=p.journal.get('due','');
      return nsOldRow(old,next) && ncDay(old.from) && npMoney(old.amount) && old.amount>=0
        && t=={'repaidCents':s.repaidCents,'lastRepayDate':s.lastRepayDate,'maxPaidDue':s.maxPaidDue,'duplicateId':s.duplicateId,'duplicateDue':s.duplicateDue,
          'termCents':eligible?npCents(old.amount):s.termCents,'termFound':s.termFound||eligible,'eligibleRepayments':s.eligibleRepayments};
    }
    function nsScan(o,p,d,previous) {
      let l=npGet(o,'entries',p.loanId).partnerLoan;
      let n=p.master.partnerLoan;
      let i=d.index;
      let r=l.repayments.size();
      let q=l.interestPayments.size();
      return i<r?d.kind=='repayment' && d.rowIndex==i && nsRepayment(p,l.repayments[i],n.repayments[i],previous.state,d.state)
        :i<r+q?d.kind=='interest' && d.rowIndex==i-r && nsInterest(p,l.interestPayments[i-r],n.interestPayments[i-r],previous.state,d.state)
        :i<r+q+l.terms.size() && d.kind=='term' && d.rowIndex==i-r-q && nsTerm(p,l.terms[i-r-q],n.terms[i-r-q],previous.state,d.state,d.rowIndex);
    }
    function nsCertificate(o,d,id) {
      let p=npGet(o,'partnerProposals',d.operationId);
      let previous=d.index==0?{'state':nsInitial(),'index':-1}:npGet(o,'partnerCertificates',d.operationId+'--'+string(d.index-1));
      return d.keys().hasOnly(['id','operationId','actorId','loanId','expectedVersion','index','kind','rowIndex','state'])
        && d.id==id && id==p.id+'--'+string(d.index) && d.index is int && d.index>=0 && previous.index==d.index-1
        && d.actorId==request.auth.uid && d.actorId==p.actorId && d.loanId==p.loanId && d.expectedVersion==p.expectedVersion && p.expense!=null && nsPrepared(o,p)
        && (d.index!=0||(nsAuthorized(o,p,'context')&&nsAuthorized(o,p,'ledger')&&nsAuthorized(o,p,'audit'))) && nsScan(o,p,d,previous);
    }
    function nsFinalMoney(o,p,cert) {
      let l=npGet(o,'entries',p.loanId).partnerLoan;
      let s=cert.state;
      let total=l.repayments.size()+l.interestPayments.size()+l.terms.size();
      let remaining=npCents(l.principal)-s.repaidCents;
      return cert.id==p.id+'--'+string(total-1) && cert.index==total-1 && cert.operationId==p.id && cert.actorId==p.actorId && cert.expectedVersion==p.expectedVersion
        && !s.duplicateId && !s.duplicateDue && (p.type=='PARTNER_INTEREST_PAID'?s.termFound && s.termCents==npCents(p.expense.amount)
          :remaining>0 && npCents(p.expense.amount)<=remaining && p.date>=s.lastRepayDate
           && (p.nextTerm==null?npCents(p.expense.amount)==remaining && s.maxPaidDue<=p.date
             :npCents(p.expense.amount)<remaining && p.type!='PARTNER_SETTLED' && s.maxPaidDue<p.nextTerm.from));
    }
    function nsRegistryAfter(o,p) {
      let d=npAfter(o,'financialControls','partner-keys');
      let b=npGet(o,'financialControls','partner-keys');
      let release=npGet(o,'financialControls','release');
      let key=p.master.partnerLoan.partner.lower()+'|'+p.master.partnerLoan.date+'|'+string(npCents(p.master.partnerLoan.principal));
      return p.registryKey==key && !(key in b.claims) && d.claims.diff(b.claims).affectedKeys().hasOnly([key]) && d.claims[key]==p.loanId
        && b.recordType=='PARTNER_KEY_INDEX' && b.protocol=='spark-partners-v1' && release.partnerIndexProtocol=='spark-partners-v1'
        && release.state=='ACTIVE' && release.protocol=='SPARK_NATIVE_BASELINE' && release.orgId==o && release.projectId==request.auth.token.aud && b.baselineId==release.baselineId
        && d.diff(b).affectedKeys().hasOnly(['claims','version','lastOperationId','acceptedAt']) && d.version==b.version+1 && d.lastOperationId==p.id && d.acceptedAt==request.time;
    }
    function nsCount(p) { return 2+(p.expense==null?0:1)+(p.financial?1:0)+(p.expectedVersion==0?1:0); }
    function nsBundle(o,op,id) {
      let p=npGet(o,'partnerProposals',id);
      return op.keys().hasOnly(['id','type','protocol','actorId','status','proposalId','certificateId','writeCount','cashAccountId','deltaCents','appliedAt'])
        && op.id==id && op.type==p.type && op.protocol=='spark-partners-v1' && op.actorId==request.auth.uid && op.actorId==p.actorId && op.proposalId==id
        && op.status=='APPLIED' && op.appliedAt==request.time && op.writeCount==nsCount(p) && op.cashAccountId==(p.financial?'leader':'') && op.deltaCents==p.deltaCents && nsPrepared(o,p)
        && (p.expense==null?op.certificateId=='' && nsAuthorized(o,p,'context') && nsAuthorized(o,p,'ledger') && nsAuthorized(o,p,'audit')
          :nsFinalMoney(o,p,npGet(o,'partnerCertificates',op.certificateId)))
        && npStamped(npAfter(o,'entries',p.loanId),p.master) && npStamped(npAfter(o,'audit',p.audit.id),p.audit)
        && (p.expense==null||npStamped(npAfter(o,'expenses',p.expense.id),p.expense)) && (!p.financial||p.date==npToday());
    }
    function nsCompanion(o,id,field,pathId) {
      let p=npGet(o,'partnerProposals',id);
      let op=npAfter(o,'operations',id);
      return nsManager(o) && p.actorId==request.auth.uid && op.id==id && op.protocol=='spark-partners-v1' && op.type==p.type && op.actorId==p.actorId && op.status=='APPLIED' && op.appliedAt==request.time
        && p[field]!=null && p[field].id==pathId && npStamped(request.resource.data,p[field])
        && (field!='master'||p.expectedVersion!=0||nsRegistryAfter(o,p))
        && (field!='audit'||!p.financial||npCashAfter(o,p.id,'leader',p.deltaCents));
    }
    function nsRegistryUpdate(o,d,id) { let p=npGet(o,'partnerProposals',d.lastOperationId); let op=npAfter(o,'operations',d.lastOperationId);
      return id=='partner-keys' && nsManager(o) && p.actorId==request.auth.uid && p.expectedVersion==0 && op.actorId==p.actorId && op.protocol=='spark-partners-v1' && op.type=='PARTNER_LOAN_CREATED' && op.status=='APPLIED' && op.appliedAt==request.time && nsRegistryAfter(o,p); }
    function nsCash(o,op,d) { let p=npGet(o,'partnerProposals',op.id); return op.type==p.type && op.actorId==p.actorId && p.financial && d.accountId=='leader' && p.date==npToday() && d.availableCents==resource.data.availableCents+p.deltaCents; }
    match /orgs/{o}/partnerProposals/{id} {
      allow get: if nsManager(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/partnerProposals/$(id))||resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && nsProposal(o,request.resource.data,id); allow update,delete: if false;
    }
    match /orgs/{o}/partnerAuthorizations/{id} {
      allow get: if nsManager(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/partnerAuthorizations/$(id))||resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && nsAuthorization(o,request.resource.data,id); allow update,delete: if false;
    }
    match /orgs/{o}/partnerCertificates/{id} {
      allow get: if nsManager(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/partnerCertificates/$(id))||resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && nsCertificate(o,request.resource.data,id); allow update,delete: if false;
    }
    match /orgs/{o}/entries/{id} {
      allow create,update: if signedIn() && v2Org(o) && nsCompanion(o,request.resource.data.get('nativePartnerOperationId',''),'master',id);
    }
    match /orgs/{o}/expenses/{id} { allow create: if signedIn() && v2Org(o) && nsCompanion(o,request.resource.data.operationId,'expense',id); }
    match /orgs/{o}/audit/{id} { allow create: if signedIn() && v2Org(o) && nsCompanion(o,request.resource.data.operationId,'audit',id); }
    match /orgs/{o}/operations/{id} { allow create: if signedIn() && v2Org(o) && request.resource.data.get('protocol','')=='spark-partners-v1' && nsBundle(o,request.resource.data,id); }
    match /orgs/{o}/financialControls/{id} { allow update: if signedIn() && v2Org(o) && nsRegistryUpdate(o,request.resource.data,id); }
// Legacy V1 rules remain unchanged in behavior, but explicitly exclude the V2 pilot org
    // so overlapping Firestore matches cannot broaden V2 permissions.
    match /users/{uid} {
      allow read: if signedIn() && ((request.auth.uid == uid && sameOrg(resource.data.orgId)) || (manager() && sameOrg(resource.data.orgId)));
      allow create: if admin() && validUserProfile(uid);
      allow update: if admin() && validUserProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if admin() && sameOrg(resource.data.orgId);
    }
    match /orgs/{orgId}/routes/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || resource.data.collectorId == request.auth.uid);
      allow create, update, delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/clients/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(request.resource.data.routeId));
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if !v2Org(orgId) && manager() && sameOrg(orgId);
    }
    match /orgs/{orgId}/credits/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(resource.data.routeId));
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || assignedRoute(request.resource.data.routeId));
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/payments/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || request.auth.uid == resource.data.userId);
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (request.resource.data.userId == request.auth.uid && assignedRoute(request.resource.data.routeId)));
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && assignedRoute(resource.data.routeId) && request.resource.data.routeId == resource.data.routeId));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/cashClosures/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || resource.data.userId == request.auth.uid);
      allow create: if !v2Org(orgId) && sameOrg(orgId) && (manager() || request.resource.data.userId == request.auth.uid);
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && manager();
    }
    match /orgs/{orgId}/approvals/{id} {
      allow read: if !v2Org(orgId) && sameOrg(orgId) && (manager() || resource.data.requestedByUid == request.auth.uid);
      allow create: if !v2Org(orgId) && sameOrg(orgId) && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if !v2Org(orgId) && sameOrg(orgId) && (manager() || (resource.data.requestedByUid == request.auth.uid && request.resource.data.requestedByUid == resource.data.requestedByUid && request.resource.data.status == resource.data.status));
      allow delete: if !v2Org(orgId) && sameOrg(orgId) && admin();
    }
    match /orgs/{orgId}/{collection}/{id} {
      allow read, write: if !v2Org(orgId) && sameOrg(orgId) && manager() && collection in ['capital','entries','expenses','audit'];
    }
  }
}
