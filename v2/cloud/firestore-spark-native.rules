        && d.version==before.version+1 && d.acceptedAt==request.time && d.lastOperationId!=before.lastOperationId
        && op.id==d.lastOperationId && op.actorId==request.auth.uid && op.status=='APPLIED' && op.appliedAt==request.time
        && (op.protocol=='spark-payment-v1'?npCashPayment(o,op,d):op.protocol=='spark-credit-v1'?npCashCredit(o,op,d):op.protocol=='spark-partners-v1'&&nsCash(o,op,d));
    }
    function npCashRead(o,d) {
