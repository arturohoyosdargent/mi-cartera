rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function validRole(r) { return r in ['admin','supervisor','cobrador','consulta']; }
    function admin() { return signedIn() && me().role == 'admin'; }
    function supervisor() { return signedIn() && me().role == 'supervisor'; }
    function manager() { return admin() || supervisor(); }
    function sameOrg(org) { return signedIn() && me().orgId == org; }
    function assignedRoute(rid) { return signedIn() && me().routeIds is list && rid in me().routeIds; }
    function validUserProfile(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.orgId is string
        && request.resource.data.orgId == me().orgId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && validRole(request.resource.data.role)
        && request.resource.data.routeIds is list
        && request.resource.data.active is bool;
    }
    // V2 pilot authorization is deliberately separate from the legacy /users profile.
    // A V1 user profile cannot grant V2 access by itself.
    function v2Org(orgId) { return orgId == 'v2-mi-cartera-pilot'; }
    function v2Member(orgId) {
      return signedIn() && v2Org(orgId)
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    function v2Me(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data;
    }
    function v2Active(orgId) { return v2Member(orgId) && v2Me(orgId).active == true; }
    function v2Manager(orgId) { return v2Active(orgId) && v2Me(orgId).role in ['admin','supervisor']; }
    function v2Collector(orgId) { return v2Active(orgId) && v2Me(orgId).role == 'cobrador'; }
    function v2AssignedRoute(orgId, rid) { return v2Active(orgId) && v2Me(orgId).routeIds is list && rid in v2Me(orgId).routeIds; }

    function v2WorkerMember(orgId) { return v2Active(orgId) && v2Me(orgId).role == 'gestor' && v2Me(orgId).workerId is string; }
    function v2WorkerLive(orgId) {
      let member = v2Me(orgId);
      let worker = get(/databases/$(database)/documents/orgs/$(orgId)/routes/$(member.workerId)).data;
      return signedIn() && v2Org(orgId) && member.active == true && member.role == 'gestor'
        && member.workerId is string && worker.recordType == 'WORKER' && worker.active == true
        && worker.authUid == request.auth.uid && member.routeIds is list && worker.routeId in member.routeIds
        && get(/databases/$(database)/documents/orgs/$(orgId)/routes/$(worker.routeId)).data.active == true;
    }
    function v2Owned(orgId, data) { let member = v2Me(orgId); return v2WorkerLive(orgId) && data.workerId == member.workerId && member.routeIds is list && data.routeId in member.routeIds; }
    function v2WorkerRead(orgId, data) { return v2WorkerLive(orgId) && data.workerId == v2Me(orgId).workerId; }
    function v2ContactAccess(orgId, clientId) {
      let key = "client-access-" + v2Me(orgId).workerId + "-" + clientId;
      let path = /databases/$(database)/documents/orgs/$(orgId)/routes/$(key);
      return v2WorkerLive(orgId) && exists(path) && get(path).data.recordType == 'CLIENT_ACCESS'
        && get(path).data.active == true && get(path).data.workerId == v2Me(orgId).workerId
        && get(path).data.clientId == clientId;
    }
    function v2ContactForCredit(orgId, clientId) {
      let key = "client-access-" + v2Me(orgId).workerId + "-" + clientId;
      return v2ContactAccess(orgId, clientId)
        && get(/databases/$(database)/documents/orgs/$(orgId)/routes/$(key)).data.creditCount > 0;
    }
    function v2ClassificationAbsent(data) {
      return !data.keys().hasAny(['portfolioClassification','portfolioClassificationReason','portfolioClassificationUpdatedAt']);
    }
    function v2WorkerCash(orgId, data, collection) {
      return v2Owned(orgId, data) && data.cashAccountId == v2Me(orgId).workerId && data.amount > 0 && (
        (collection == 'entries' && data.type == 'INGRESO' && data.concept in ['COBRO_CUOTA','COBRO_INTERES']
          && !exists(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref))
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.workerId == data.workerId
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.cashMovementId == data.id
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/payments/$(data.ref)).data.amount == data.amount)
        || (collection == 'expenses' && data.type == 'EGRESO' && data.concept in ['DESEMBOLSO_CREDITO','DESEMBOLSO_REFINANCIAMIENTO']
          && !exists(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref))
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.workerId == data.workerId
          && getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.disbursementMovementId == data.id
          && ((data.concept == 'DESEMBOLSO_CREDITO' && data.amount == getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.capital)
            || (data.concept == 'DESEMBOLSO_REFINANCIAMIENTO' && data.amount == getAfter(/databases/$(database)/documents/orgs/$(orgId)/credits/$(data.ref)).data.netDisbursement)))
      );
    }

                                                        // Spark-native payment v1. Preparation has no financial effects. All financial
    // grants below require a final, immutable operation and the complete bundle.
    function npGet(o, collection, id) { return get(/databases/$(database)/documents/orgs/$(o)/$(collection)/$(id)).data; }
    function npAfter(o, collection, id) { return getAfter(/databases/$(database)/documents/orgs/$(o)/$(collection)/$(id)).data; }
    function npKey(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function npMin(a,b) { return a<b?a:b; }
    function npMax(a,b) { return a>b?a:b; }
    function npCents(v) { return int(math.round(v * 100)); }
    function npMoney(v) { return (v is int || v is float) && v == math.round(v * 100) / 100.0 && math.abs(v) <= 9000000000; }
    function npMember(o) { return signedIn() && v2Org(o) && npGet(o, 'members', request.auth.uid).active == true; }
    function npPad(n) { return (n<10?'0':'')+string(n); }
    function npToday() { let t=request.time-duration.value(5,'h'); return string(t.year())+'-'+npPad(t.month())+'-'+npPad(t.day()); }
    function npCommercialLive(o,c) { return (!exists(/databases/$(database)/documents/orgs/$(o)/routes/$(c.routeId)) || npGet(o,'routes',c.routeId).get('active',true)!=false) && (c.get('workerId','')=='' || !exists(/databases/$(database)/documents/orgs/$(o)/routes/$(c.workerId)) || npGet(o,'routes',c.workerId).get('active',true)!=false); }
    function npActor(o, c) {
      let m = npGet(o, 'members', request.auth.uid);
      return signedIn() && v2Org(o) && m.active == true
        && (m.role in ['admin','supervisor']
          || (m.role == 'cobrador' && c.routeId in m.routeIds && npCommercialLive(o,c))
          || (m.role == 'gestor' && v2Owned(o, c)));
    }
    function npOpen(c) { return c.status == 'ACTIVO' && c.get('tombstone', false) == false
      && c.get('noReplay', false) == false && c.get('renewedTo', '') == ''
      && c.get('administrativeClosure', {}).get('noReplay', false) == false; }
    function npProposal(o, p, id) {
      let c = npGet(o, 'credits', p.creditId);
      let pay = p.payment;
      let e = p.entry;
      let a = p.audit;
      return p.keys().hasOnly(['id','protocol','actorId','creditId','paymentId','entryId','auditId','expectedVersion','amountCents','credit','payment','entry','audit'])
        && p.id == id && npKey(id) && npKey(p.creditId) && npKey(p.paymentId) && npKey(p.entryId) && npKey(p.auditId)
        && p.protocol == 'spark-payment-v1' && p.actorId == request.auth.uid && npActor(o, c) && npOpen(c)
        && p.expectedVersion is int && p.expectedVersion == c.version && p.expectedVersion >= 1
        && p.credit.id == c.id && p.credit.version == c.version + 1
        && p.credit.nativePaymentOperationId == id
        && p.credit.diff(c).affectedKeys().hasOnly(['principalPaid','interestPaid','penaltyPaid','status','schedule','version','updatedAt','acceptedAt','nativePaymentOperationId'])
        && c.schedule is list && c.schedule.size() > 0 && p.credit.schedule is list && p.credit.schedule.size() == c.schedule.size()
        && npMoney(c.capital) && npMoney(c.get('principalPaid',0)) && npMoney(c.get('interestPaid',0)) && npMoney(c.get('penaltyPaid',0))
        && p.credit.penaltyPaid == c.get('penaltyPaid',0)
        && p.amountCents is int && p.amountCents > 0 && npMoney(pay.amount) && npCents(pay.amount) == p.amountCents
        && pay.keys().hasOnly(['id','creditId','clientId','routeId','userId','workerId','workerAttribution','amount','date','concept','capitalAmount','interestAmount','penaltyAmount','operationId','version','installmentNumber','installmentNo','installmentFrom','installmentTo','totalInstallments','installmentApplications','balanceAfterPayment','cashMovementId','method'])
        && pay.id == p.paymentId && pay.operationId == id && pay.creditId == c.id && pay.clientId == c.clientId
        && pay.userId == p.actorId && pay.routeId == c.routeId && pay.workerId == c.get('workerId','')
        && pay.workerAttribution == {'source':'CREDIT_ASSIGNMENT_AT_PAYMENT'}
        && pay.concept == 'CUOTA' && pay.version == 1 && pay.cashMovementId == p.entryId
        && pay.date is string && pay.date == npToday()
        && npMoney(pay.capitalAmount) && npMoney(pay.interestAmount) && pay.penaltyAmount == 0
        && e.keys().hasOnly(['id','ref','amount','date','type','concept','routeId','version','actorId','operationId','creditId','cashAccountId'])
        && e.id == p.entryId && e.ref == pay.id && e.amount == pay.amount && e.date == pay.date
        && e.type == 'INGRESO' && e.concept == 'COBRO_CUOTA' && e.version == 1
        && e.routeId == c.routeId && e.creditId == c.id && e.actorId == p.actorId && e.operationId == id
        && e.cashAccountId == (c.get('workerId','') == '' ? 'leader' : c.workerId)
        && a.id == p.auditId && a.actorId == p.actorId && a.role == npGet(o,'members',request.auth.uid).role
        && a.action in ['PAYMENT','PAYMENT_RECORDED'] && a.entityType == 'PAYMENT' && a.entityId == pay.id && a.operationId == id && a.version == 1
        && a.detail.amount == pay.amount && a.detail.get('creditId', c.id) == c.id
        && a.detail.get('capitalAmount', pay.capitalAmount) == pay.capitalAmount && a.detail.get('interestAmount', pay.interestAmount) == pay.interestAmount;
    }
    function npDelta(old, amount, before) { return npMin(npCents(old.get('balance', old.amount)), npMax(0, amount - before)); }
    function npApp(a, number, used, bal) { return a.keys().hasOnly(['number','amount','balanceBefore','balanceAfter','status']) && a.number==number && a.amount==used / 100.0 && a.balanceBefore==bal / 100.0 && a.balanceAfter==(bal-used) / 100.0 && a.status==(bal==used?'PAGADA':'PARCIAL'); }
    function npRow(c, p, d, j) {
      let i = d.start + j;
      let old = c.schedule[i];
      let next = p.credit.schedule[i];
      let bal = npCents(old.get('balance', old.amount));
      let paid = npCents(old.get('paid',0));
      let used = npMin(bal,npMax(0,p.amountCents-d.prefix[j]));
      let count = d.applicationPrefix[j];
      return npMoney(old.get('balance',old.amount)) && npMoney(old.get('paid',0)) && bal >= 0 && paid >= 0
        && d.prefix[j] is int && d.prefix[j+1] is int && d.prefix[j+1] == d.prefix[j]+bal
        && count is int && d.applicationPrefix[j+1] == count+(used>0?1:0)
        && (used==0 ? next==old : next.diff(old).affectedKeys().hasOnly(['paid','balance','status'])
          && next.paid==(paid+used) / 100.0 && next.balance==(bal-used) / 100.0 && next.status==(bal==used?'PAGADA':'PARCIAL'))
        && (used==0 || npApp(p.payment.installmentApplications[count],i+1,used,bal));
    }
    function npPartRow(c,p,d,j) { return d.start+j >= d.end || npRow(c,p,d,j); }
    function npCertificate(o,d,id) {
      let p=npGet(o,'paymentProposals',d.operationId);
      let c=npGet(o,'credits',d.creditId);
      let previous=d.index==0?{'prefix':[0],'applicationPrefix':[0],'end':0}:npGet(o,'paymentCertificates',d.operationId+'--'+string(d.index-1));
      return d.keys().hasOnly(['id','operationId','actorId','creditId','expectedVersion','index','start','end','prefix','applicationPrefix'])
        && npKey(d.operationId) && d.index is int && d.index>=0 && d.id==id && id==d.operationId+'--'+string(d.index)
        && d.actorId==request.auth.uid && p.actorId==d.actorId && d.creditId==p.creditId && npActor(o,c)
        && d.expectedVersion==p.expectedVersion && c.version==d.expectedVersion && npOpen(c)
        && d.start==d.index*1 && d.start<c.schedule.size() && d.end==npMin(d.start+1,c.schedule.size())
        && previous.end==d.start && d.prefix is list && d.prefix.size()==d.end-d.start+1
        && d.applicationPrefix is list && d.applicationPrefix.size()==d.prefix.size()
        && d.prefix[0]==previous.prefix[previous.prefix.size()-1]
        && d.applicationPrefix[0]==previous.applicationPrefix[previous.applicationPrefix.size()-1]
        && npPartRow(c,p,d,0);
    }
    function npStamped(actual, target) { return actual.keys().hasAll(target.keys())
      && actual.diff(target).affectedKeys().hasOnly(['acceptedAt']) && actual.acceptedAt == request.time; }
    function npFinalMoney(c, p, cert) {
      let balance = cert.prefix[cert.prefix.size()-1];
      let principal = npCents(c.capital) - npCents(c.get('principalPaid',0));
      let capital = p.amountCents == balance ? principal : npMin(principal,int(math.round(p.amountCents * principal / balance)));
      let applications = p.payment.installmentApplications;
      return balance > 0 && p.amountCents <= balance && principal >= 0 && principal <= balance
        && c.get('principalPaid',0) >= 0 && c.get('interestPaid',0) >= 0
        && p.payment.capitalAmount >= 0 && p.payment.interestAmount >= 0 && capital <= p.amountCents && cert.end == c.schedule.size()
        && npCents(p.payment.capitalAmount) == capital && npCents(p.payment.interestAmount) == p.amountCents-capital
        && p.credit.principalPaid == (npCents(c.get('principalPaid',0))+capital) / 100.0
        && p.credit.interestPaid == (npCents(c.get('interestPaid',0))+p.amountCents-capital) / 100.0
        && p.credit.status == (p.amountCents==balance?'PAGADO':'ACTIVO')
        && p.payment.balanceAfterPayment == (balance-p.amountCents) / 100.0
        && cert.applicationPrefix[cert.applicationPrefix.size()-1] == applications.size() && applications.size() > 0
        && p.payment.installmentNumber == applications[0].number && p.payment.installmentNo == applications[0].number
        && p.payment.installmentFrom == applications[0].number && p.payment.installmentTo == applications[applications.size()-1].number
        && p.payment.totalInstallments == c.schedule.size();
    }
    function npBundle(o, op, id) {
      let p = npGet(o,'paymentProposals',id);
      let c = npGet(o,'credits',p.creditId);
      let cert = npGet(o,'paymentCertificates',op.certificateId);
      return op.keys().hasOnly(['id','type','protocol','actorId','status','proposalId','certificateId','writeCount','appliedAt'])
        && op.id == id && op.proposalId == id && op.type == 'PAYMENT' && op.protocol == 'spark-payment-v1'
        && op.actorId == request.auth.uid && p.actorId == op.actorId && op.status == 'APPLIED' && op.writeCount == 4 && op.appliedAt == request.time
        && npMember(o) && p.audit.role == npGet(o,'members',request.auth.uid).role && p.payment.date == npToday() && npOpen(c) && c.version == p.expectedVersion
        && cert.operationId == id && cert.creditId == c.id && cert.expectedVersion == c.version && npFinalMoney(c,p,cert)
        && npStamped(npAfter(o,'credits',p.creditId),p.credit) && npStamped(npAfter(o,'payments',p.paymentId),p.payment)
        && npStamped(npAfter(o,'entries',p.entryId),p.entry) && npStamped(npAfter(o,'audit',p.auditId),p.audit)
        && npCashAfter(o,id,p.entry.cashAccountId,p.amountCents);
    }
    function npCompanion(o, operationId, collection, id) {
      let p = npGet(o,'paymentProposals',operationId);
      let op = npAfter(o,'operations',operationId);
      return signedIn() && v2Org(o) && p.actorId == request.auth.uid && op.actorId == p.actorId
        && op.protocol == 'spark-payment-v1' && op.type == 'PAYMENT' && op.status == 'APPLIED' && op.appliedAt == request.time
        && (collection!='credit' || npActor(o,resource.data))
        && npStamped(request.resource.data,p[collection]) && request.resource.data.id == id;
    }
    function npMetadataType(type) { return type in ['CLIENT_CREATE','CLIENT_UPDATE','CLIENT_CREATED','CLIENT_UPDATED','ROUTE_SAVED','WORKER_SAVED','WORKER_ASSIGNMENT','CREDIT_REFERENCE_UPDATED']; }
    function npMetadataOperation(op,id) { return op.keys().hasOnly(['id','type','fingerprint','status','createdAt','appliedAt','writeCount','actorId']) && op.id==id && npMetadataType(op.type); }
    function npMetadataRoute(d,id) { return !(id in ['spark-financial-capability','spark-financial-mutex','spark-native-cash']) && d.recordType in ['ROUTE','WORKER','ASSIGNMENT','CLIENT_ACCESS']; }
    function npMetadataCredit() { return request.resource.data.version == resource.data.version+1
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerId','routeId','assignedAt','beneficiaryReference','version','updatedAt']); }
    match /orgs/v2-mi-cartera-pilot { allow read: if true; allow write: if false; }
    match /orgs/{o}/members/{id} { allow get: if signedIn() && v2Org(o) && request.auth.uid==id; allow write: if false; }
    match /orgs/{o}/paymentProposals/{id} {
      allow get: if npMember(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/paymentProposals/$(id)) || resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && npProposal(o,request.resource.data,id);
      allow update,delete: if false;
    }
    match /orgs/{o}/paymentCertificates/{id} {
      allow get: if npMember(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/paymentCertificates/$(id)) || resource.data.actorId==request.auth.uid);
      allow create: if signedIn() && v2Org(o) && npCertificate(o,request.resource.data,id);
      allow update,delete: if false;
    }
    match /orgs/{o}/credits/{id} {
      allow read: if v2Org(o) && (v2Manager(o) || (v2Collector(o) && v2AssignedRoute(o,resource.data.routeId)) || v2WorkerRead(o,resource.data));
      allow update: if signedIn() && v2Org(o) && (npCompanion(o,request.resource.data.get('nativePaymentOperationId',''),'credit',id) || ncCreditCompanion(o,id) || (v2Manager(o) && npMetadataCredit()));
      allow create: if signedIn() && v2Org(o) && ncCreditCompanion(o,id);
      allow delete: if false;
    }
    match /orgs/{o}/payments/{id} {
      allow get: if npMember(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/payments/$(id)) || v2Manager(o) || resource.data.userId==request.auth.uid);
      allow list: if v2Org(o) && (v2Manager(o) || (v2Collector(o) && resource.data.userId==request.auth.uid) || v2WorkerRead(o,resource.data));
      allow create: if signedIn() && v2Org(o) && (npCompanion(o,request.resource.data.operationId,'payment',id) || ncCompanion(o,request.resource.data.operationId,'payment',id));
      allow update,delete: if false;
    }
    match /orgs/{o}/entries/{id} {
      allow get: if npMember(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/entries/$(id)) || v2Manager(o) || resource.data.get('actorId','')==request.auth.uid);
      allow list: if v2Org(o) && (v2Manager(o) || v2WorkerRead(o,resource.data));
      allow create: if signedIn() && v2Org(o) && (npCompanion(o,request.resource.data.operationId,'entry',id) || ncCompanion(o,request.resource.data.operationId,'entry',id));
      allow update,delete: if false;
    }
    match /orgs/{o}/audit/{id} {
      allow get: if npMember(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/audit/$(id)) || v2Manager(o) || resource.data.actorId==request.auth.uid);
      allow list: if v2Org(o) && (v2Manager(o) || resource.data.actorId==request.auth.uid && npMember(o));
      allow create: if signedIn() && v2Org(o) && (npCompanion(o,request.resource.data.operationId,'audit',id) || ncCompanion(o,request.resource.data.operationId,'audit',id) || (v2Manager(o) && npMetadataType(request.resource.data.action) && request.resource.data.actorId==request.auth.uid));
      allow update,delete: if false;
    }
    match /orgs/{o}/operations/{id} {
      allow get: if npMember(o) && (!exists(/databases/$(database)/documents/orgs/$(o)/operations/$(id)) || v2Manager(o) || resource.data.get('actorId','')==request.auth.uid);
      allow list: if v2Org(o) && v2Manager(o);
      allow create: if signedIn() && v2Org(o) && (request.resource.data.get('protocol','')=='spark-payment-v1' && npBundle(o,request.resource.data,id) || request.resource.data.get('protocol','')=='spark-credit-v1' && ncBundle(o,request.resource.data,id) || (v2Manager(o) && npMetadataOperation(request.resource.data,id)));
      allow update,delete: if false;
    }
    match /orgs/{o}/clients/{id} {
      allow read: if v2Org(o) && (v2Manager(o) || (v2Collector(o) && v2AssignedRoute(o,resource.data.routeId)) || v2WorkerRead(o,resource.data));
      allow create: if v2Org(o) && v2Manager(o); allow update: if v2Org(o) && v2Manager(o); allow delete: if false;
    }
    match /orgs/{o}/expenses/{id} {
      allow create: if signedIn() && v2Org(o) && ncCompanion(o,request.resource.data.operationId,'expense',id);
      allow update,delete: if false;
    }
    match /orgs/{o}/{collection}/{id} {
      allow read: if v2Org(o) && v2Manager(o) && collection in ['capital','expenses','cashClosures','routes'];
      allow create: if v2Org(o) && v2Manager(o) && collection=='routes' && npMetadataRoute(request.resource.data,id);
      allow update: if v2Org(o) && v2Manager(o) && collection=='routes' && npMetadataRoute(resource.data,id) && npMetadataRoute(request.resource.data,id);
      allow delete: if false;
    }

    // Only the protected release initializes a verified position. Browser writes
    // can apply the exact delta of an accompanying, accepted native operation.
    function npCashAfter(o,operationId,accountId,deltaCents) {
      let d=npAfter(o,'financialControls','cash--'+accountId);
      let release=npGet(o,'financialControls','release');
      return release.protocol=='SPARK_NATIVE_BASELINE' && release.state=='ACTIVE' && release.orgId==o
        && release.projectId==request.auth.token.aud && d.baselineId==release.baselineId
        && d.protocol=='spark-cash-v1' && d.recordType=='CASH_POSITION' && d.accountId==accountId
        && d.lastOperationId==operationId && d.acceptedAt==request.time;
    }
    function npCashPayment(o,op,d) {
      let p=npGet(o,'paymentProposals',op.id);
      return op.type=='PAYMENT' && op.actorId==p.actorId && d.accountId==p.entry.cashAccountId
        && p.payment.date==npToday() && d.availableCents==resource.data.availableCents+p.amountCents;
    }
    function npCashCredit(o,op,d) {
      let p=npGet(o,'creditProposals',op.id);
      let delta=p.entry!=null?npCents(p.entry.amount):p.expense!=null?-npCents(p.expense.amount):0;
      return op.type==p.type && op.actorId==p.actorId && d.accountId=='leader'
        && (p.type=='CREDIT_CREATE'?p.expense.date:p.credit.date)==npToday()
        && d.availableCents==resource.data.availableCents+delta;
    }
    function npCashUpdate(o,d,id) {
      let before=resource.data;
      let op=npAfter(o,'operations',d.lastOperationId);
      let release=npGet(o,'financialControls','release');
      return npMember(o) && id=='cash--'+d.accountId && before.protocol=='spark-cash-v1'
        && release.protocol=='SPARK_NATIVE_BASELINE' && release.state=='ACTIVE' && release.orgId==o
        && release.projectId==request.auth.token.aud && before.baselineId==release.baselineId
